{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samuori.invalid/schemas/buildspec/v1alpha1.json",
  "title": "Samuori ImageBuild v1alpha1",
  "description": "Portable build intent. Design: docs/architecture/buildspec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "samuori.invalid/v1alpha1"
    },
    "kind": {
      "const": "ImageBuild"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._@+ -]+(/[A-Za-z0-9._@+ -]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "absolutePath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^/[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "digestPinnedImage": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+(:[A-Za-z0-9_.-]+)?@sha256:[a-f0-9]{64}$"
    },
    "stringMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,252}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "imageMetadata": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 255
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      ]
    },
    "systemPackageList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "build"
      ],
      "properties": {
        "application": {
          "$ref": "#/$defs/application"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "secrets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/secret"
          }
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9-]+$": true
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "method": {
                    "const": "recipe"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "application"
            ],
            "properties": {
              "application": {
                "required": [
                  "type",
                  "runtime"
                ]
              },
              "build": {
                "required": [
                  "recipe"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "dockerfile"
                      ]
                    },
                    {
                      "required": [
                        "railpack"
                      ]
                    },
                    {
                      "required": [
                        "buildpacks"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "method": {
                    "const": "dockerfile"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "build": {
                "required": [
                  "dockerfile"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "recipe"
                      ]
                    },
                    {
                      "required": [
                        "railpack"
                      ]
                    },
                    {
                      "required": [
                        "buildpacks"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "method": {
                    "const": "railpack"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "build": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "recipe"
                      ]
                    },
                    {
                      "required": [
                        "dockerfile"
                      ]
                    },
                    {
                      "required": [
                        "buildpacks"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "build": {
                "properties": {
                  "method": {
                    "const": "buildpacks"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "build": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "recipe"
                      ]
                    },
                    {
                      "required": [
                        "dockerfile"
                      ]
                    },
                    {
                      "required": [
                        "railpack"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "validation"
            ],
            "properties": {
              "validation": {
                "required": [
                  "profile"
                ],
                "properties": {
                  "profile": {
                    "const": "http-startup"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "application"
            ],
            "properties": {
              "application": {
                "required": [
                  "port"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "application"
            ],
            "properties": {
              "build": {
                "properties": {
                  "method": {
                    "const": "recipe"
                  }
                }
              },
              "application": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "http-service"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "application": {
                "required": [
                  "port"
                ]
              }
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "http-service",
            "static-site",
            "worker",
            "cli-task",
            "database",
            "other"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language"
          ],
          "properties": {
            "language": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9+.-]{0,31}$"
            },
            "framework": {
              "type": "string",
              "maxLength": 64
            },
            "versionConstraint": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPath": {
          "type": "string",
          "pattern": "^/[^\\s]{0,255}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "recipe",
            "dockerfile",
            "railpack",
            "buildpacks"
          ]
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "install": {
              "$ref": "#/$defs/command"
            },
            "build": {
              "$ref": "#/$defs/command"
            },
            "start": {
              "$ref": "#/$defs/command"
            },
            "test": {
              "$ref": "#/$defs/command"
            },
            "parameters": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 256
              },
              "description": "Values for a custom recipe's parameters (ADR 0041); checked against the recipe when the build is admitted."
            },
            "systemPackages": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build": {
                  "$ref": "#/$defs/systemPackageList"
                },
                "runtime": {
                  "$ref": "#/$defs/systemPackageList"
                }
              },
              "description": "Operating system packages a built-in recipe installs with its base image's package manager: build in the build stage, runtime in the final image (docs/architecture/buildspec.md#system-packages)."
            },
            "path": {
              "$ref": "#/$defs/relativePath",
              "description": "The application's folder in the upload; the upload's root when omitted."
            },
            "frontend": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/relativePath"
                },
                "install": {
                  "$ref": "#/$defs/command"
                },
                "build": {
                  "$ref": "#/$defs/command"
                },
                "output": {
                  "$ref": "#/$defs/relativePath",
                  "default": "dist"
                },
                "node": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}$"
                },
                "apiPrefixes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "pattern": "^/[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$"
                  }
                },
                "backendPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "description": "A browser frontend built with Node.js and served from the same image by Samuori's web launcher, which forwards the API paths to the application (ADR 0055, docs/architecture/buildspec.md#frontend)."
            }
          }
        },
        "dockerfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": {
              "$ref": "#/$defs/relativePath",
              "default": "."
            },
            "path": {
              "$ref": "#/$defs/relativePath",
              "default": "Dockerfile"
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "namedContexts": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "$ref": "#/$defs/relativePath"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "image"
                    ],
                    "properties": {
                      "image": {
                        "$ref": "#/$defs/digestPinnedImage"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "railpack": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for the railpack method (ADR 0047). Commands override Railpack's choice and run in build steps, never during planning.",
          "properties": {
            "context": {
              "$ref": "#/$defs/relativePath",
              "default": "."
            },
            "buildCommand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\n\\r]+$"
            },
            "startCommand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\n\\r]+$"
            }
          }
        },
        "buildpacks": {
          "type": "object",
          "additionalProperties": false,
          "description": "Options for the buildpacks method (ADR 0047). The CNB lifecycle from the approved builder detects and builds the context on the worker, never during discovery.",
          "properties": {
            "context": {
              "$ref": "#/$defs/relativePath",
              "default": "."
            },
            "env": {
              "type": "object",
              "maxProperties": 64,
              "description": "Non-secret buildpack configuration, such as BP_NODE_VERSION; BPE_ and BPL_ variables reach the image",
              "propertyNames": {
                "pattern": "^(BP|BPE|BPL)_[A-Z0-9_]{1,120}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\n\\r\\x00]*$"
              }
            },
            "bindings": {
              "type": "array",
              "maxItems": 32,
              "description": "CNB service bindings, each one file holding a logical build secret",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type",
                  "secret"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
                  },
                  "secret": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$|^\\.[A-Za-z0-9_][A-Za-z0-9_.-]{0,126}$"
                  }
                }
              }
            }
          }
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/buildArg"
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preference": {
              "enum": [
                "buildkit"
              ]
            }
          }
        }
      }
    },
    "buildArg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "confirmedNotSecret": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "name": {
            "pattern": "([Pp][Aa][Ss][Ss]([Ww][Oo][Rr][Dd]|[Ww][Dd])|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|(^|_)[Kk][Ee][Yy]$)"
          }
        }
      },
      "then": {
        "required": [
          "confirmedNotSecret"
        ],
        "properties": {
          "confirmedNotSecret": {
            "const": true
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
        },
        "type": {
          "enum": [
            "text",
            "binary"
          ],
          "default": "text"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "usage": {
          "enum": [
            "build",
            "test"
          ],
          "default": "build"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "mount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/absolutePath",
              "not": {
                "pattern": "^/(proc|sys|dev)(/|$)"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(linux|windows)/(amd64|arm64|arm|386|ppc64le|s390x|riscv64)(/v[5-8])?$"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "http-startup",
            "process-start",
            "cli-smoke",
            "static-serve",
            "none-requested"
          ]
        },
        "extraChecks": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "$ref": "#/$defs/imageMetadata"
            },
            "annotations": {
              "$ref": "#/$defs/imageMetadata"
            },
            "tags": {
              "type": "array",
              "maxItems": 16,
              "description": "Tags a publication applies when the publisher gives none: OCI tags, or {version} for the build's version (ADR 0054). Absent means [\"{version}\"].",
              "items": {
                "type": "string",
                "pattern": "^(\\{version\\}|[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})$"
              }
            }
          }
        },
        "sbom": {
          "type": "boolean"
        },
        "provenance": {
          "type": "boolean"
        },
        "expectedSensitiveContent": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/absolutePath"
              },
              "reason": {
                "type": "string",
                "minLength": 10,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "automatic"
          ]
        },
        "destinationRef": {
          "$ref": "#/$defs/name"
        },
        "requestedTags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
          }
        }
      },
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "automatic"
          }
        }
      },
      "then": {
        "required": [
          "destinationRef"
        ]
      }
    }
  }
}
